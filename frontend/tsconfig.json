{
  "compilerOptions": {
    "target": "ES2019", 
    "module": "esnext",
    "jsx": "react-jsx", 
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true // If you need to import JavaScript files
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
